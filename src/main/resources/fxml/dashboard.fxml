<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.talan.creditplatform.controller.ui.DashboardController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #1e1e2e;">

    <!-- TOP NAV BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #2a2a3e; -fx-padding: 12 20 12 20;">
            <Label text="Credit Platform"
                   style="-fx-text-fill: #7c9ef5; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="roleLabel"
                   style="-fx-text-fill: #a0a0c0; -fx-font-size: 12px;"/>
            <Label fx:id="usernameLabel"
                   style="-fx-text-fill: #c0c0e0; -fx-font-size: 12px;"/>
            <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #e05050; -fx-text-fill: white; -fx-font-size: 12px; -fx-cursor: hand; -fx-background-radius: 6;"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="4" style="-fx-background-color: #252535; -fx-padding: 16 8 16 8;" prefWidth="190">
            <Label text="MENU" style="-fx-text-fill: #6060a0; -fx-font-size: 10px; -fx-padding: 4 8 4 8;"/>
            <Button fx:id="menuDossiers" text="  Dossiers" onAction="#showDossiers" maxWidth="Infinity"
                    style="-fx-background-color: #3a3a5c; -fx-text-fill: #c0c0e0; -fx-alignment: CENTER_LEFT; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 12;"/>
            <Button fx:id="menuEvaluate" text="  Evaluate" onAction="#showEvaluate" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0c0; -fx-alignment: CENTER_LEFT; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 12;"/>
            <Button fx:id="menuHistory" text="  History" onAction="#showHistory" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0c0; -fx-alignment: CENTER_LEFT; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 12;"/>
            <Button fx:id="menuAdmin" text="  Admin" onAction="#showAdmin" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0a0c0; -fx-alignment: CENTER_LEFT; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 12;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #1e1e2e; -fx-padding: 24;">
            <!-- Default content: welcome card -->
            <VBox alignment="CENTER" spacing="20">
                <Label fx:id="welcomeLabel" text="Welcome!"
                       style="-fx-text-fill: #e0e0ff; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Label fx:id="subtitleLabel" text="Select an option from the sidebar to get started."
                       style="-fx-text-fill: #8080b0; -fx-font-size: 14px;"/>

                <!-- Quick action cards row -->
                <HBox spacing="16" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="8" prefWidth="160" prefHeight="110"
                          style="-fx-background-color: #2a2a3e; -fx-background-radius: 10; -fx-padding: 16; -fx-cursor: hand;"
                          onMouseClicked="#showDossiers">
                        <Label text="📁" style="-fx-font-size: 28px;"/>
                        <Label text="Dossiers" style="-fx-text-fill: #c0c0ff; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label text="View credit files" style="-fx-text-fill: #7070a0; -fx-font-size: 11px;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" prefWidth="160" prefHeight="110"
                          style="-fx-background-color: #2a2a3e; -fx-background-radius: 10; -fx-padding: 16; -fx-cursor: hand;"
                          onMouseClicked="#showEvaluate">
                        <Label text="⚡" style="-fx-font-size: 28px;"/>
                        <Label text="Evaluate" style="-fx-text-fill: #c0c0ff; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label text="Run credit pipeline" style="-fx-text-fill: #7070a0; -fx-font-size: 11px;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" prefWidth="160" prefHeight="110"
                          style="-fx-background-color: #2a2a3e; -fx-background-radius: 10; -fx-padding: 16; -fx-cursor: hand;"
                          onMouseClicked="#showHistory">
                        <Label text="📊" style="-fx-font-size: 28px;"/>
                        <Label text="History" style="-fx-text-fill: #c0c0ff; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label text="Past evaluations" style="-fx-text-fill: #7070a0; -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <!-- STATUS BAR -->
    <bottom>
        <HBox style="-fx-background-color: #16162a; -fx-padding: 6 16;">
            <Label fx:id="statusBar" text="Ready"
                   style="-fx-text-fill: #505080; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>
