<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!--
        Local dev pattern — human-readable, aligned with actual MDC keys
        written by MdcFilter (traceId, user, httpCode, executionTime).
    -->
    <property name="logPattern"
              value="%d{HH:mm:ss.SSS} %-5level %logger - %msg%ex%n"/>

    <!--
        CONSOLE — structured JSON appender for staging / production.
        Uses LoggingEventCompositeJsonEncoder with logstash-logback-encoder v9.x.
        All MDC keys are safely serialised via <mdc/> (Jackson-backed, no injection risk).
        Stack traces are included via <stackTrace> with ShortenedThrowableConverter.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>

                <!-- ISO-8601 UTC timestamp -->
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>

                <!-- Level name: INFO, WARN, ERROR, … -->
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>

                <!-- Numeric level value for log aggregators (Kibana, Graylog) -->
                <provider class="com.talan.creditplatform.logging.LogLevelValueJsonProvider">
                    <fieldName>level_value</fieldName>
                </provider>

                <!-- Thread name -->
                <threadName>
                    <fieldName>thread_name</fieldName>
                </threadName>

                <!-- Fully-qualified logger name -->
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>

                <!--
                    MDC — captures ALL keys set by MdcFilter (traceId, user, httpCode,
                    executionTime, executionSpeed, …) using the Jackson serialiser,
                    which properly escapes special characters. Replaces the unsafe
                    raw <pattern> string interpolation used previously.
                -->
                <mdc/>

                <!-- Application log message (trailing newlines stripped) -->
                <provider class="com.talan.creditplatform.logging.TrimmedMessageJsonProvider">
                    <fieldName>message</fieldName>
                </provider>

                <!--
                    Stack trace — included only when an exception is attached to the
                    log event. ShortenedThrowableConverter caps depth and shortens
                    class names to keep payloads manageable.
                -->
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerCause>20</maxDepthPerCause>
                        <shortenedClassNameLength>36</shortenedClassNameLength>
                        <exclude>sun\.reflect\..*</exclude>
                        <exclude>java\.lang\.reflect\..*</exclude>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>

            </providers>
        </encoder>
    </appender>

    <!-- ── Default / local dev: human-readable plain text ──────────── -->
    <springProfile name="!prod">
        <appender name="DEVCONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <charset>UTF-8</charset>
                <Pattern>${logPattern}</Pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="DEVCONSOLE"/>
        </root>
    </springProfile>

    <!-- ── Production: structured JSON ─────────────────────────────── -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ── Noise reduction ───────────────────────────────────────────── -->
    <logger name="org.hibernate"                       level="WARN"/>
    <logger name="org.hibernate.SQL"                   level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql"   level="WARN"/>
    <logger name="org.springframework.web"             level="WARN"/>
    <logger name="org.springframework.security"        level="WARN"/>

</configuration>
